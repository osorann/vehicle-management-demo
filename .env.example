# ------------------------------------------------------------
# 環境変数のサンプル。.env.local にコピーして値を設定してください。
# すべて未設定の場合は「デモモード」のみで動作します。
# ------------------------------------------------------------

# Supabase（Project Settings > API）
NEXT_PUBLIC_SUPABASE_URL=
# Publishable key（sb_publishable_...）または従来の anon key のどちらか一方
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# デモモードの表示制御（true / false）
# 未指定時: Supabase 未設定なら有効、設定済みなら無効
# NEXT_PUBLIC_ENABLE_DEMO=true
